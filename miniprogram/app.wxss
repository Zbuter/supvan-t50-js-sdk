page {
  min-height: 100%;
  background: #f3f4f1;
  color: #171a18;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
slider,
switch,
canvas {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: inherit;
  background: transparent;
  color: inherit;
  font-size: inherit;
}

button::after {
  border: 0;
}

.safe-top {
  padding-top: env(safe-area-inset-top);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 18, 16, 0.36);
}

.bottom-sheet {
  width: 100%;
  max-height: 78vh;
  overflow: auto;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
  box-shadow: 0 -16rpx 48rpx rgba(24, 31, 26, 0.12);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 99rpx;
  background: #d9ddd9;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-subtitle {
  margin-top: 8rpx;
  color: #7b817d;
  font-size: 24rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-weight: 650;
}

.primary-button {
  background: #171a18;
  color: #fff;
}

.secondary-button {
  background: #eef1ee;
  color: #262b27;
}

.danger-button {
  background: #fff0ee;
  color: #b33a2e;
}

.field-label {
  display: block;
  margin: 24rpx 0 10rpx;
  color: #6e746f;
  font-size: 24rpx;
}

.field-input {
  width: 100%;
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e3e7e3;
  border-radius: 18rpx;
  background: #f8f9f7;
  font-size: 28rpx;
}
