<view class="home-page">
  <view class="home-nav" style="padding-top: {{statusBarHeight}}px; padding-right: {{menuRightInset}}px; min-height: {{navigationHeight}}px;">
    <view>
      <view class="brand">SUPVAN</view>
      <view class="nav-title">标签工作台</view>
    </view>
    <button class="import-button" bindtap="importClipboard">从剪贴板导入</button>
  </view>

  <view class="hero-card">
    <view class="hero-copy">
      <view class="hero-kicker">T50 · 8 点/mm</view>
      <view class="hero-title">
        <text class="hero-title-line">像在纸上排版一样</text>
        <text class="hero-title-line">拖动你的标签</text>
      </view>
      <view class="hero-note">直接点选、拖动、缩放，再连接蓝牙打印。</view>
    </view>
    <button class="hero-action" bindtap="showCustomSize">＋ 新建空白</button>
  </view>

  <view class="section" wx:if="{{workings.length}}">
    <view class="section-header">
      <view class="section-title">继续编辑</view>
      <view class="section-caption">{{workings.length}} 份 · 自动保存</view>
    </view>
    <button class="working-card" wx:for="{{workings}}" wx:key="id" data-id="{{item.id}}" bindtap="continueWorking">
      <view class="working-preview">
        <view class="preview-line strong"></view>
        <view class="preview-line"></view>
        <view class="preview-code"></view>
      </view>
      <view class="working-info">
        <view class="working-name">{{item.name}}</view>
        <view class="working-meta">{{item.size}} · {{item.pageCount}} 页 · {{item.objectCount}} 个对象</view>
        <view class="working-time">{{item.timeLabel}}</view>
      </view>
      <view class="working-arrow">›</view>
    </button>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title">快速开始</view>
      <view class="section-caption">模板复制后可自由编辑</view>
    </view>
    <scroll-view class="template-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <button class="template-card tone-{{item.tone}}" wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="useTemplate">
        <view class="template-label">
          <view class="template-line wide"></view>
          <view class="template-line"></view>
          <view class="template-code"></view>
        </view>
        <view class="template-name">{{item.name}}</view>
        <view class="template-description">{{item.description}}</view>
        <view class="template-size">{{item.size}}</view>
      </button>
    </scroll-view>
  </view>

  <view class="section" wx:if="{{drafts.length}}">
    <view class="section-header">
      <view class="section-title">已保存标签</view>
      <view class="section-caption">{{drafts.length}} 份</view>
    </view>
    <button class="draft-row" wx:for="{{drafts}}" wx:key="id" data-id="{{item.id}}" bindtap="openDraft">
      <view class="draft-icon">L</view>
      <view class="draft-content">
        <view class="draft-name">{{item.name}}</view>
        <view class="draft-meta">{{item.size}} · {{item.pageCount || 1}} 页 · {{item.timeLabel}}</view>
      </view>
      <view class="working-arrow">›</view>
    </button>
  </view>

  <view class="home-footer safe-bottom">本地保存 · 不上传标签内容</view>
</view>

<view class="sheet-mask" wx:if="{{showCustomSize}}" bindtap="closeCustomSize">
  <view class="bottom-sheet" catchtap="stopPropagation">
    <button class="sheet-close" bindtap="closeCustomSize" aria-label="关闭">关闭</button>
    <view class="sheet-title">新建空白标签</view>
    <view class="sheet-subtitle">T50 支持宽 1–50 mm、高 1–120 mm</view>
    <view class="size-fields">
      <view class="size-field">
        <text class="field-label">宽度（mm）</text>
        <input class="field-input" type="digit" value="{{customWidth}}" bindinput="onCustomWidth" />
      </view>
      <view class="size-multiply">×</view>
      <view class="size-field">
        <text class="field-label">高度（mm）</text>
        <input class="field-input" type="digit" value="{{customHeight}}" bindinput="onCustomHeight" />
      </view>
    </view>
    <button class="primary-button create-button" bindtap="createCustom">进入编辑画布</button>
  </view>
</view>
