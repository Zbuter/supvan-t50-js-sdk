<view class="page editor-page" wx:if="{{document}}">
  <view class="editor-header">
    <view>
      <view class="title">{{document.name || '可编辑标签'}}</view>
      <view class="muted">小程序只编辑参数，画布用于只读预览</view>
    </view>
    <button class="text-button" bindtap="goBack">返回</button>
  </view>

  <view class="card preview-card">
    <view class="section-title">标签预览</view>
    <view class="canvas-wrap">
      <canvas id="preview" type="2d" class="preview-canvas" style="{{previewStyle}}" bindtap="onCanvasTap"></canvas>
    </view>
    <view class="preview-meta">{{document.width}} × {{document.height}} mm</view>
    <view wx:if="{{selectedObject}}" class="preview-controls">
      <view class="preview-control-row">
        <button class="fine-toggle-button" disabled="{{!selectedObject.canEditPosition}}" bindtap="toggleFineTune">{{fineTuneEnabled ? '关闭微调' : '开启微调'}}</button>
        <button class="canvas-control-button rotate-control-button" aria-label="旋转当前对象 90 度" disabled="{{!selectedObject.canEditRotation}}" bindtap="rotateSelectedObject">↻</button>
      </view>
      <view class="preview-control-row direction-row">
        <button class="canvas-control-button" data-direction="left" disabled="{{!selectedObject.canEditPosition}}" bindtap="moveSelectedObject">←</button>
        <button class="canvas-control-button" data-direction="up" disabled="{{!selectedObject.canEditPosition}}" bindtap="moveSelectedObject">↑</button>
        <button class="canvas-control-button" data-direction="down" disabled="{{!selectedObject.canEditPosition}}" bindtap="moveSelectedObject">↓</button>
        <button class="canvas-control-button" data-direction="right" disabled="{{!selectedObject.canEditPosition}}" bindtap="moveSelectedObject">→</button>
      </view>
    </view>
  </view>

  <view class="card page-settings">
    <view class="section-title">页面</view>
    <view class="form-grid">
      <view class="field">
        <view class="field-label">宽度（mm）</view>
        <input class="field-input" type="digit" value="{{pageWidth}}" data-field="width" bindinput="onPageInput" />
      </view>
      <view class="field">
        <view class="field-label">高度（mm）</view>
        <input class="field-input" type="digit" value="{{pageHeight}}" data-field="height" bindinput="onPageInput" />
      </view>
    </view>
    <button class="secondary-button compact-button" bindtap="applyPageSize">应用页面尺寸</button>
  </view>

  <view wx:if="{{variables.length}}" class="card variables-card">
    <view class="section-title">模板变量</view>
    <view wx:for="{{variables}}" wx:key="name" class="variable-row">
      <view class="field-label">{{item.label}}</view>
      <input class="field-input" value="{{item.value}}" data-index="{{index}}" bindinput="onVariableInput" />
    </view>
    <button class="secondary-button compact-button" bindtap="applyVariables">应用变量</button>
  </view>

  <view class="card add-object-card">
    <view class="section-title">添加元素</view>
    <view class="add-object-grid">
      <button class="add-object-button" data-type="text" bindtap="addObject">文字</button>
      <button class="add-object-button" data-type="qr" bindtap="addObject">二维码</button>
      <button class="add-object-button" data-type="barcode" bindtap="addObject">条码</button>
      <button class="add-object-button" data-type="rectangle" bindtap="addObject">矩形</button>
      <button class="add-object-button" data-type="line" bindtap="addObject">直线</button>
    </view>
    <view class="muted add-object-hint">添加后会自动选中，可直接修改内容、尺寸和位置。</view>
  </view>

  <view class="objects-section">
    <view class="section-title">元素属性</view>
    <view wx:if="{{!document.objects.length}}" class="card empty-card muted">这个标签还没有元素，可以在上方“添加元素”中直接创建。</view>
    <view wx:elif="{{!selectedObject}}" class="card empty-card muted">请直接点击上方预览中的元素进行选择。</view>

    <view wx:if="{{selectedObject}}" class="card object-card">
      <view class="object-heading">
        <view>
          <view class="object-title">{{selectedObject.title}}</view>
          <view class="muted">{{selectedObject.typeLabel}}</view>
        </view>
        <view class="object-index">{{selectedObjectIndex + 1}}</view>
      </view>

      <view wx:if="{{selectedObject.hasContent}}" class="field content-field">
        <view class="field-label">{{selectedObject.type === 'text' ? '文字内容' : selectedObject.type === 'qr' ? '二维码内容' : '条码内容'}}</view>
        <textarea wx:if="{{selectedObject.type === 'text'}}" class="field-textarea" value="{{selectedObject.content}}" maxlength="10000" data-field="content" disabled="{{!selectedObject.canEditContent}}" bindinput="onObjectInput" />
        <input wx:else class="field-input" value="{{selectedObject.content}}" maxlength="10000" data-field="content" disabled="{{!selectedObject.canEditContent}}" bindinput="onObjectInput" />
      </view>

      <view class="form-grid geometry-grid">
        <view class="field">
          <view class="field-label">X（mm）</view>
          <input class="field-input" type="digit" value="{{selectedObject.x}}" data-field="x" disabled="{{!selectedObject.canEditPosition}}" bindinput="onObjectInput" />
        </view>
        <view class="field">
          <view class="field-label">Y（mm）</view>
          <input class="field-input" type="digit" value="{{selectedObject.y}}" data-field="y" disabled="{{!selectedObject.canEditPosition}}" bindinput="onObjectInput" />
        </view>
        <view class="field">
          <view class="field-label">宽度（mm）</view>
          <input class="field-input" type="digit" value="{{selectedObject.width}}" data-field="width" disabled="{{!selectedObject.canEditSize}}" bindinput="onObjectInput" />
        </view>
        <view class="field">
          <view class="field-label">高度（mm）</view>
          <input class="field-input" type="digit" value="{{selectedObject.height}}" data-field="height" disabled="{{!selectedObject.canEditSize}}" bindinput="onObjectInput" />
        </view>
      </view>

      <view class="form-grid" wx:if="{{selectedObject.canEditRotation || selectedObject.type === 'text'}}">
        <view wx:if="{{selectedObject.canEditRotation}}" class="field">
          <view class="field-label">旋转（度）</view>
          <input class="field-input" type="digit" value="{{selectedObject.rotation}}" data-field="rotation" bindinput="onObjectInput" />
        </view>
        <view wx:if="{{selectedObject.type === 'text' && selectedObject.canEditStyle}}" class="field">
          <view class="field-label">字号（mm）</view>
          <input class="field-input" type="digit" value="{{selectedObject.fontSize}}" data-field="fontSize" bindinput="onObjectInput" />
        </view>
      </view>

      <view wx:if="{{selectedObject.type === 'text' && selectedObject.canEditStyle}}" class="picker-row">
        <view class="field-label">对齐方式</view>
        <picker mode="selector" range="{{selectedObject.alignOptions}}" value="{{selectedObject.alignIndex}}" data-field="align" bindchange="onObjectPickerChange">
          <view class="picker-value">{{selectedObject.alignOptions[selectedObject.alignIndex]}} <text class="picker-arrow">⌄</text></view>
        </picker>
      </view>
      <view wx:if="{{selectedObject.type === 'barcode' && selectedObject.canEditStyle}}" class="picker-row">
        <view class="field-label">条码制式</view>
        <picker mode="selector" range="{{selectedObject.formatOptions}}" value="{{selectedObject.formatIndex}}" data-field="format" bindchange="onObjectPickerChange">
          <view class="picker-value">{{selectedObject.formatOptions[selectedObject.formatIndex]}} <text class="picker-arrow">⌄</text></view>
        </picker>
      </view>

      <button class="secondary-button compact-button" bindtap="applyObject">应用此元素属性</button>
    </view>
  </view>

  <view wx:if="{{status}}" class="status-message">{{status}}</view>
  <button class="primary-button save-button" bindtap="saveLabel">保存标签</button>
</view>
